{
  "id": "squashmerge",
  "label": "SquashMerge",
  "version": "1.0.0",
  "default": true,
  "assets": ["brand/cultivate-logo-dark-v1.png"],
  "tokens": {
    "--mimir-color-text": "#F7F7FB",
    "--mimir-color-text-muted": "#B8BAC8",
    "--mimir-color-background": "#0B0C10",
    "--mimir-color-chrome-background": "#14151D",
    "--mimir-color-chrome-border": "#777A8E",
    "--mimir-color-chrome-accent": "#FFAA10",
    "--mimir-color-chrome-accent-text": "#0B0C10",
    "--mimir-color-panel-background": "#14151D",
    "--mimir-color-panel-background-muted": "#1D1E2A",
    "--mimir-color-panel-border": "#777A8E",
    "--mimir-color-panel-border-hover": "#ABA5FF",
    "--mimir-color-panel-shadow": "none",
    "--mimir-color-status-info": "#85C7FF",
    "--mimir-color-status-info-background": "#14151D",
    "--mimir-color-status-success": "#57D6A0",
    "--mimir-color-status-success-background": "#14151D",
    "--mimir-color-status-warning": "#FFC20A",
    "--mimir-color-status-warning-background": "#14151D",
    "--mimir-color-status-danger": "#FF8E9A",
    "--mimir-color-status-danger-background": "#14151D",
    "--mimir-color-timeline-reasoning": "#ABA5FF",
    "--mimir-color-timeline-reasoning-background": "#1D1E2A",
    "--mimir-color-timeline-tool-call": "#FFC20A",
    "--mimir-color-timeline-tool-call-background": "#1D1E2A",
    "--mimir-color-timeline-tool-result": "#57D6A0",
    "--mimir-color-timeline-tool-result-background": "#1D1E2A",
    "--mimir-color-trigger-saga-session-end": "#ABA5FF",
    "--mimir-color-trigger-scheduled-tick": "#FFC20A",
    "--mimir-color-trigger-poller": "#85C7FF",
    "--mimir-color-trigger-user-message": "#ABA5FF",
    "--mimir-color-trigger-synthesis": "#57D6A0",
    "--mimir-color-trigger-heartbeat": "#FF8E9A",
    "--mimir-color-trigger-claude-code-spawn": "#85C7FF",
    "--mimir-color-trigger-shell-job-complete": "#FFC20A",
    "--mimir-color-code-background": "#0B0C10",
    "--mimir-color-code-text": "#F7F7FB",
    "--mimir-color-focus-ring": "#ABA5FF",
    "--mimir-font-family-base": "system-ui, sans-serif",
    "--mimir-font-family-mono": "ui-monospace, monospace",
    "--mimir-font-size-xs": "0.75rem",
    "--mimir-font-size-sm": "0.875rem",
    "--mimir-font-size-md": "1rem",
    "--mimir-font-size-lg": "1.125rem",
    "--mimir-font-weight-regular": "400",
    "--mimir-font-weight-strong": "650",
    "--mimir-line-height-tight": "1.4",
    "--mimir-line-height-body": "1.5",
    "--mimir-radius-panel": "12px",
    "--mimir-radius-control": "8px",
    "--mimir-space-2xs": "4px",
    "--mimir-space-xs": "8px",
    "--mimir-space-sm": "12px",
    "--mimir-space-md": "16px",
    "--mimir-space-lg": "24px",
    "--mimir-space-xl": "32px",
    "--mimir-space-shell-inline": "24px",
    "--mimir-space-shell-block": "48px",
    "--mimir-elevation-panel": "none",
    "--mimir-elevation-overlay": "none",
    "--mimir-border-width-hairline": "1px",
    "--mimir-border-width-chrome": "1px",
    "--mimir-interaction-hover-background": "#1D1E2A",
    "--mimir-interaction-active-background": "#7770DC",
    "--mimir-interaction-disabled-opacity": "0.65",
    "--mimir-motion-duration-fast": "120ms",
    "--mimir-motion-duration-normal": "180ms"
  },
  "chrome": { "layout": "top-nav", "density": "comfortable", "accentPlacement": "top-rule" },
  "panel": { "surface": "flat", "borderStyle": "solid", "hoverBehavior": "border-accent" },
  "characterRenderer": {
    "kind": "react-placeholder", "componentSlot": "agent-character", "variant": "default",
    "assets": [], "stateMap": {}, "fallbackState": "idle",
    "capabilities": { "supportsExpressions": false, "supportsMotion": false }
  }
}

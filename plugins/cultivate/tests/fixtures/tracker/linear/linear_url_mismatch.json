{
  "source": "Linear GraphQL API reference https://linear.app/developers/graphql and schema https://studio.apollographql.com/public/Linear-API/variant/current/schema/reference: Query.issues (IssueFilter.delegate, IssueFilter.state.type), Issue.id/identifier/url/updatedAt, IssueConnection.pageInfo (wrong host and mismatched identifier segment) and Query.issue(id:), Issue.id/identifier/url/title/description/createdAt/creator/delegate/state.type/team.key, Issue.history(IssueHistoryConnection) with IssueHistory.id/createdAt/actor/toDelegate/fromTitle/toTitle/updatedDescription, Issue.comments with Comment.id/createdAt/editedAt/body/user, Connection.pageInfo.hasNextPage",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "json": {
          "query": "query Viewer { viewer { id } }",
          "variables": {}
        }
      },
      "response": {
        "status": 200,
        "json": {
          "data": {
            "viewer": {
              "id": "usr-bot"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "json": {
          "query": "query AssignedIssues($filter: IssueFilter) { issues(filter: $filter, first: 50, orderBy: updatedAt) { nodes { id identifier url updatedAt } pageInfo { hasNextPage } } }",
          "variables": {
            "filter": {
              "delegate": {
                "id": {
                  "eq": "usr-bot"
                }
              },
              "state": {
                "type": {
                  "nin": [
                    "completed",
                    "canceled"
                  ]
                }
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "data": {
            "issues": {
              "nodes": [
                {
                  "id": "iss-1",
                  "identifier": "ENG-1",
                  "url": "https://evil.example/acme/issue/ENG-1/fix-login-crash",
                  "updatedAt": "2026-10-20T11:00:00.000Z"
                },
                {
                  "id": "iss-2",
                  "identifier": "ENG-2",
                  "url": "https://linear.app/acme/issue/ENG-999/fix-login-crash",
                  "updatedAt": "2026-10-20T12:00:00.000Z"
                }
              ],
              "pageInfo": {
                "hasNextPage": false
              }
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "json": {
          "query": "query ReadIssue($id: String!) { issue(id: $id) { id identifier url title description createdAt creator { id } delegate { id } state { type } team { key } history(first: 100) { pageInfo { hasNextPage } nodes { id createdAt actor { id } toDelegate { id } fromTitle toTitle updatedDescription } } comments(first: 100) { pageInfo { hasNextPage } nodes { id createdAt editedAt body user { id } } } } }",
          "variables": {
            "id": "ENG-123"
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "data": {
            "issue": {
              "id": "iss-123",
              "identifier": "ENG-123",
              "url": "https://evil.example/acme/issue/ENG-123/fix-login-crash",
              "title": "Fix login crash",
              "description": "Login crashes on submit.",
              "createdAt": "2026-10-20T09:00:00.000Z",
              "creator": {
                "id": "usr-alice"
              },
              "delegate": {
                "id": "usr-bot"
              },
              "state": {
                "type": "started"
              },
              "team": {
                "key": "ENG"
              },
              "history": {
                "pageInfo": {
                  "hasNextPage": false
                },
                "nodes": [
                  {
                    "id": "h1",
                    "createdAt": "2026-10-20T10:00:00.000Z",
                    "actor": {
                      "id": "usr-alice"
                    },
                    "toDelegate": {
                      "id": "usr-bot"
                    },
                    "fromTitle": null,
                    "toTitle": null,
                    "updatedDescription": false
                  }
                ]
              },
              "comments": {
                "pageInfo": {
                  "hasNextPage": false
                },
                "nodes": []
              }
            }
          }
        }
      }
    }
  ]
}
